# From your Supabase project: Settings > Database > Connection string
# DATABASE_URL = "Transaction" pooler (port 6543) — used by the app at runtime
# DIRECT_URL   = "Session"/direct connection (port 5432) — used by Prisma Migrate
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"
