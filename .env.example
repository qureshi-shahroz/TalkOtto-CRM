# From your Supabase project: Settings > Database > Connection string (or the "Connect" button)
# DATABASE_URL = "Transaction pooler" (port 6543) — used by the app at runtime
# DIRECT_URL   = "Session pooler" / direct connection (port 5432) — used by Prisma Migrate
#
# connection_limit=5 on DATABASE_URL matters: this app fires several queries
# concurrently per page (Promise.all in the dashboard + sidebar). Prisma's default
# limit is much higher and can overwhelm Supabase's pooler; limit=1 (too low) causes
# queries to queue and time out ("Timed out fetching a new connection from the pool").
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"
